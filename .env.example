# Quran Platform Environment Variables

# ============================================
# DATABASE
# ============================================
# When pointing at a pooled endpoint (Neon "-pooler" host, PgBouncer in
# transaction mode), pgbouncer=true is required: without it Prisma uses named
# prepared statements, which the pooler cannot keep across connections and the
# connection gets closed mid-query. connection_limit=1 keeps each serverless
# instance to a small pool against the shared pooler. Do not drop this to 1:
# the Next.js build prerenders pages in parallel workers and a limit of 1
# starves them, baking "Page Not Found" into pages whose query timed out.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/quran_platform?schema=public&pgbouncer=true&connection_limit=5&connect_timeout=15&pool_timeout=30"

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Quran Platform"

# ============================================
# RATE LIMITING (Upstash Redis - optional)
# ============================================
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ============================================
# PRAYER TIMES
# ============================================
# AlAdhan API is free and requires no key
NEXT_PUBLIC_ALADHAN_API="https://api.aladhan.com/v1"
